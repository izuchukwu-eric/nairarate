# Copy to .dev.vars for local `wrangler dev`. Never commit real values.
# In production these are set with `wrangler secret put <NAME>`.

# Monierate API key — https://account.monierate.com
# Required by the Monierate collector (parallel + crypto street rates).
MONIERATE_API_KEY=

# USDC-on-Base address that receives x402 payments.
X402_WALLET_ADDRESS=

# Optional: 'base-sepolia' (default) or 'base'. Normally set in wrangler.toml [vars].
X402_NETWORK=base-sepolia

# No facilitator credentials are required — the facilitators used (x402.org for
# Sepolia, PayAI for mainnet) need no account and no API key.
